{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-harness.local/schema/harness.schema.json",
  "title": "Team Harness Manifest",
  "type": "object",
  "required": ["version", "ide", "stacks", "features", "installed"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Installed team-harness package version (semver)"
    },
    "harnessRef": {
      "type": "string",
      "description": "Optional git ref or submodule pointer"
    },
    "ide": {
      "type": "string",
      "description": "cursor | codebuddy | claude | codex | both | all | comma-separated list"
    },
    "ides": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cursor", "codebuddy", "claude", "codex"]
      },
      "uniqueItems": true
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["global", "git", "golang", "python", "frontend", "docker", "zsh"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precommit": { "type": "boolean" },
        "ci": { "type": "string", "enum": ["github", false] },
        "skills": { "type": "boolean" },
        "skeleton": { "type": "boolean" },
        "commands": { "type": "boolean" },
        "agents": { "type": "boolean" }
      },
      "required": ["precommit", "ci", "skills", "skeleton", "commands", "agents"]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "primaryStack": {
          "type": "string",
          "enum": ["golang", "python", "frontend", "generic"]
        }
      }
    },
    "installed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "source", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "rule",
              "template",
              "scaffold",
              "agents",
              "docs",
              "command",
              "subagent"
            ]
          }
        }
      }
    }
  }
}
